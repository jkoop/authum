<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>403 · authum</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;600&display=swap" rel="stylesheet">
<% @include('styles') %>
</head>
<body>
<div class="wrap">
  <a class="brand" href="<%= @admin_href %>">authum</a>
  <h1>403 Forbidden</h1>
  <div class="panel stack">
    <p class="msg-err"><%= @reason %></p>
    <table class="kv">
      <tbody>
        <tr><th>host</th><td><code><%= @host %></code></td></tr>
        <tr><th>path</th><td><code><%= @path %></code></td></tr>
        <tr><th>method</th><td><code><%= @method %></code></td></tr>
        <tr><th>site</th><td><code><%= @site_name %></code></td></tr>
        <tr><th>user</th><td><code><%= @user_name %></code></td></tr>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
