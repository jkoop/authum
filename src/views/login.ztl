<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Login · authum</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;600&display=swap" rel="stylesheet">
<% @include('styles') %>
</head>
<body>
<div class="wrap">
  <div class="brand">authum</div>
  <h1>Login</h1>
  <div class="panel stack">
    <p class="lede">This is the authum login domain. Your password is entered only here—not on each app—so password managers stay happy.</p>
    <% if (@has_from_site) { -%>
      <p class="lede">Sign in to continue to <strong><%= @from_site %></strong>. After login you will return to that site with a session cookie for that host.</p>
    <% } else { -%>
      <p class="lede">Sign in to manage your account password, or open a protected site and you will be sent here automatically.</p>
    <% } -%>
    <% if (@has_error) { -%>
      <p class="msg-err"><%= @err_msg %></p>
    <% } -%>
    <form method="POST" action="/login" autocomplete="on">
      <input type="hidden" name="from_site" value="<%= @from_site %>">
      <input type="hidden" name="from_path" value="<%= @from_path %>">
      <label>Username</label>
      <input name="username" autocomplete="username" required>
      <label>Password</label>
      <input name="password" type="password" autocomplete="current-password" required>
      <p style="margin-top:1rem"><button type="submit">Log in</button></p>
    </form>
    <% if (@discord_enabled) { -%>
      <p style="margin-top:1.25rem;color:var(--muted)">or</p>
      <p><a class="btn" href="<%= @discord_href %>" style="display:inline-block;text-decoration:none">Log in with Discord</a></p>
    <% } -%>
  </div>
</div>
</body>
</html>
